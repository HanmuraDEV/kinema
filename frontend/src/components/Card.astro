---
interface Props {
  class?: string;
  bodyClass?: string;
  mediaClass?: string;
  imageSrc?: string;
  imageAlt?: string;
  variant?: 'default' | 'feature';
  imageFit?: 'cover' | 'contain';
}

const {
  class: className = '',
  bodyClass = '',
  mediaClass = 'h-40',
  imageSrc = '',
  imageAlt = '',
  variant = 'default',
  imageFit = 'cover',
} = Astro.props;

const variantClasses = {
  default: 'bg-surface-container-lowest rounded-xl border border-outline-variant/30',
  feature: 'bg-transparent rounded-none border-none',
};

const bodyClasses = {
  default: 'p-4',
  feature: 'p-0',
};

const imageClasses = {
  default: 'transition-transform duration-500 group-hover:scale-110',
  feature: 'transition-transform duration-500 group-hover:scale-110',
};
---

<article class:list={['group cursor-pointer overflow-hidden', variantClasses[variant], className]}>
  {
    imageSrc ? (
      <div class:list={['overflow-hidden relative', mediaClass]}>
        <img
          alt={imageAlt}
          class:list={[
            'w-full h-full',
            imageFit === 'contain' ? 'object-contain' : 'object-cover',
            imageClasses[variant],
          ]}
          src={imageSrc}
        />
      </div>
    ) : (
      <slot name="media" />
    )
  }

  <div class:list={['', bodyClasses[variant], bodyClass]}>
    <slot />
  </div>
</article>
