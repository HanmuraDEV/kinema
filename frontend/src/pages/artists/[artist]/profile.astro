---
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.vue';
import Card from '../../../components/Card.vue';

// SSR: el parámetro es el id numérico de la persona (/api/people/{id}).
const { artist } = Astro.params;
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

let apiPerson = null;
let filmography = [];
if (artist && /^\d+$/.test(artist)) {
  try {
    const res = await fetch(`${API_URL}/api/people/${artist}`);
    if (res.ok) {
      const json = await res.json();
      apiPerson = json.person;
      filmography = (json.filmography ?? []).map((c) => ({
        id: c.movie?.id,
        title: c.movie?.title ?? '?',
        year: (c.movie?.release_date || '').slice(0, 4) || c.movie?.release_year || '',
        credit: [c.job, c.character].filter(Boolean).join(' como '),
        image: c.movie?.poster_path || '',
      }));
    }
  } catch (e) { console.error('person show falló:', e); }
}

const profile = {
  name: apiPerson?.name ?? 'Denis Villeneuve',
  role: apiPerson?.known_for_department ?? 'Director • Escritor • Productor',
  bio: apiPerson?.biography || 'Aclamado cineasta franco-canadiense conocido por su estilo visual distintivo y narrativas complejas. Su filmografía abarca desde thrillers psicológicos íntimos hasta epopeyas de ciencia ficción de gran escala, siempre manteniendo un enfoque profundo en la condición humana.',
  image: apiPerson?.profile_path || '',
  genres: [],
  careerClusters: [],
  filmography: filmography.length > 0 ? filmography : [
    {
      id: null,
      title: 'Dune: Parte Dos',
      year: '2024',
      credit: 'Director, Escritor',
      image: '',
    },
    {
      id: null,
      title: 'Blade Runner 2049',
      year: '2017',
      credit: 'Director',
      image: '',
    },
  ],
};
---

<Layout title={`Kinema - Perfil de ${artist}`}>
  <main class="flex-grow w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-gutter">
    <header class="flex flex-col md:flex-row items-center md:items-start gap-gutter mb-12">
      <div class="relative w-48 h-48 md:w-64 md:h-64 rounded-full overflow-hidden bg-surface-container-high flex items-center justify-center text-center font-headline-md text-headline-md text-on-surface-variant p-4">
        {profile.image ? (
          <img alt={profile.name} class="w-full h-full object-cover" src={profile.image} />
        ) : (
          <span>{profile.name}</span>
        )}
      </div>

      <div class="text-center md:text-left flex-1 space-y-4">
        <h1 class="font-headline-xl text-headline-xl text-on-background mt-4 md:mt-0">{profile.name}</h1>
        <p class="font-label-md text-label-md text-primary tracking-widest uppercase">{profile.role}</p>
        <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl leading-relaxed">{profile.bio}</p>
        {profile.genres.length > 0 && (
          <div class="flex flex-wrap justify-center md:justify-start gap-2 pt-4">
            {profile.genres.map((genre) => (
              <span class="px-4 py-2 bg-primary-container/30 text-on-primary-container rounded font-label-sm text-label-sm">
                {genre}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      {profile.careerClusters.length > 0 && (
        <section class="md:col-span-4 py-6 border-b md:border-b-0 md:border-r border-outline-variant/30 md:pr-8">
        <h2 class="font-headline-md text-headline-md mb-6 flex items-center gap-2 text-on-background">
          <span class="material-symbols-outlined text-primary">pie_chart</span>
          Clusters de Carrera
        </h2>

        <div class="relative w-48 h-48 mx-auto flex items-center justify-center">
          <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
            <circle class="text-surface-container-highest" cx="50" cy="50" fill="transparent" r="40" stroke="currentColor" stroke-width="20"></circle>
            <circle class="text-primary transition-all duration-1000 ease-out" cx="50" cy="50" fill="transparent" r="40" stroke="currentColor" stroke-dasharray="251.2" stroke-dashoffset="50.24" stroke-width="20"></circle>
            <circle class="text-secondary transition-all duration-1000 ease-out delay-300" cx="50" cy="50" fill="transparent" r="40" stroke="currentColor" stroke-dasharray="251.2" stroke-dashoffset="213.52" stroke-width="20"></circle>
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span class="font-headline-md text-headline-md font-bold text-primary">80%</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant text-center leading-tight">Sci-Fi<br />Complejo</span>
          </div>
        </div>

        <div class="mt-8 space-y-3">
          {profile.careerClusters.map((item) => (
            <div class="flex items-center justify-between font-label-md text-label-md border-b border-outline-variant/20 pb-2">
              <div class="flex items-center gap-2">
                <span class={`w-3 h-3 rounded-full ${item.color}`}></span>
                <span>{item.label}</span>
              </div>
              <span class="text-on-surface-variant">{item.value}</span>
            </div>
          ))}
        </div>
      </section>
      )}

      <section class={`${profile.careerClusters.length > 0 ? 'md:col-span-8' : 'md:col-span-12'} bg-surface/50 rounded p-6 shadow-[0_15px_30px_-5px_rgba(0,106,104,0.05)] border border-white/40 backdrop-blur-md`}>
        <div class="flex items-center justify-between mb-6">
          <h2 class="font-headline-md text-headline-md flex items-center gap-2 text-on-background">
            <span class="material-symbols-outlined text-secondary">movie</span>
            Filmografía Destacada
          </h2>
          <span class="font-label-sm text-label-sm text-on-surface-variant bg-surface-container px-3 py-1 rounded">{profile.filmography.length} Películas</span>
        </div>

        <div class="space-y-4">
          {profile.filmography.map((movie) => (
            <a href={movie.id ? `/movie?id=${movie.id}` : '#'}>
              <Card
                class="group flex items-center gap-4 rounded border border-transparent p-4 transition-all duration-300 hover:border-white/50 hover:bg-white/80"
                bodyClass="flex-1 flex items-center gap-4"
                variant="feature"
              >
                <div slot="media" class="relative h-24 w-16 flex-none overflow-hidden rounded bg-surface-container-highest flex items-center justify-center text-center font-label-sm text-label-sm text-on-surface-variant p-1">
                  {movie.image ? (
                    <img alt={movie.title} class="h-full w-full object-cover" src={movie.image} />
                  ) : (
                    <span>{movie.title}</span>
                  )}
                  <div class="absolute inset-0 bg-primary/0 transition-colors group-hover:bg-primary/10"></div>
                </div>
                <div class="flex-1">
                  <h3 class="font-label-md text-label-md text-on-background text-lg mb-1 transition-colors group-hover:text-primary">{movie.title}</h3>
                  <p class="font-body-md text-body-md text-on-surface-variant text-sm">{movie.year} • {movie.credit}</p>
                </div>
              </Card>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>
