---
import Layout from "../../../../layouts/Layout.astro";
import ListDetail from "../../../../components/ListDetail.vue";

const { username, slug } = Astro.params;
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

// SSR: pinta al instante si la lista es pública. Las privadas (o el rol
// de dueño) se resuelven en el cliente con el token en ListDetail.
let apiList = null;
try {
  const res = await fetch(`${API_URL}/api/users/${encodeURIComponent(username || '')}/lists/${encodeURIComponent(slug || '')}`);
  if (res.ok) apiList = await res.json();
} catch (e) {
  console.error('Lista API falló, el cliente reintentará con sesión:', e);
}
---

<Layout title={apiList ? `Kinema - ${apiList.name} de ${username}` : `Kinema - Lista de ${username}/${slug}`}>
  <main
    class="flex-grow w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-8 pb-32 md:pb-12"
  >
    <ListDetail
      client:load
      listId={apiList?.id ?? null}
      username={username}
      slug={slug}
      initialList={apiList}
      initialItems={apiList?.items ?? []}
    />
  </main>
</Layout>
