---
import Layout from '../../layouts/Layout.vue';
import Card from '../../components/Card.vue';
import Button from '../../components/Button.vue';

export function getStaticPaths() {
  return [
    { params: { username: 'cinelover99' } },
    { params: { username: 'elenacine' } },
