---

<Layout title="Kinema - Perfil del Reparto y Equipo">
  <main class="flex-grow w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-gutter">
    <header class="flex flex-col md:flex-row items-center md:items-start gap-gutter mb-12">
      <div class="relative w-48 h-48 md:w-64 md:h-64 rounded-full overflow-hidden">
        <img alt={profile.name} class="w-full h-full object-cover" src={profile.image} />
      </div>

      <div class="text-center md:text-left flex-1 space-y-4">
        <h1 class="font-headline-xl text-headline-xl text-on-background mt-4 md:mt-0">{profile.name}</h1>
        <p class="font-label-md text-label-md text-primary tracking-widest uppercase">{profile.role}</p>
        <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl leading-relaxed">{profile.bio}</p>
        <div class="flex flex-wrap justify-center md:justify-start gap-2 pt-4">
          {profile.genres.map((genre) => (
            <span class="px-4 py-2 bg-primary-container/30 text-on-primary-container rounded font-label-sm text-label-sm">
              {genre}
            </span>
          ))}
        </div>
      </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <section class="md:col-span-4 py-6 border-b md:border-b-0 md:border-r border-outline-variant/30 md:pr-8">
        <h2 class="font-headline-md text-headline-md mb-6 flex items-center gap-2 text-on-background">
          <span class="material-symbols-outlined text-primary">pie_chart</span>
          Clusters de Carrera
        </h2>

        <div class="relative w-48 h-48 mx-auto flex items-center justify-center">
          <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
            <circle class="text-surface-container-highest" cx="50" cy="50" fill="transparent" r="40" stroke="currentColor" stroke-width="20"></circle>
            <circle class="text-primary transition-all duration-1000 ease-out" cx="50" cy="50" fill="transparent" r="40" stroke="currentColor" stroke-dasharray="251.2" stroke-dashoffset="50.24" stroke-width="20"></circle>
            <circle class="text-secondary transition-all duration-1000 ease-out delay-300" cx="50" cy="50" fill="transparent" r="40" stroke="currentColor" stroke-dasharray="251.2" stroke-dashoffset="213.52" stroke-width="20"></circle>
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span class="font-headline-md text-headline-md font-bold text-primary">80%</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant text-center leading-tight">Sci-Fi<br />Complejo</span>
          </div>
        </div>

        <div class="mt-8 space-y-3">
          {profile.careerClusters.map((item) => (
            <div class="flex items-center justify-between font-label-md text-label-md border-b border-outline-variant/20 pb-2">
              <div class="flex items-center gap-2">
                <span class={`w-3 h-3 rounded-full ${item.color}`}></span>
                <span>{item.label}</span>
              </div>
              <span class="text-on-surface-variant">{item.value}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="md:col-span-8 bg-surface/50 rounded p-6 shadow-[0_15px_30px_-5px_rgba(0,106,104,0.05)] border border-white/40 backdrop-blur-md">
        <div class="flex items-center justify-between mb-6">
          <h2 class="font-headline-md text-headline-md flex items-center gap-2 text-on-background">
            <span class="material-symbols-outlined text-secondary">movie</span>
            Filmografía Destacada
          </h2>
          <span class="font-label-sm text-label-sm text-on-surface-variant bg-surface-container px-3 py-1 rounded">11 Películas</span>
        </div>

        <div class="space-y-4">
          {profile.filmography.map((movie) => (
            <div class="group flex items-center gap-4 p-4 rounded hover:bg-white/80 transition-all duration-300 border border-transparent hover:border-white/50 cursor-pointer">
              <div class="w-16 h-24 bg-surface-container-highest rounded overflow-hidden relative">
                <img alt={movie.title} class="w-full h-full object-cover" src={movie.image} />
                <div class="absolute inset-0 bg-primary/0 group-hover:bg-primary/10 transition-colors"></div>
              </div>
              <div class="flex-1">
                <h3 class="font-label-md text-label-md text-on-background text-lg mb-1 group-hover:text-primary transition-colors">{movie.title}</h3>
                <p class="font-body-md text-body-md text-on-surface-variant text-sm">{movie.year} • {movie.credit}</p>
              </div>
              <div class="flex flex-col items-end gap-1">
                <span class="font-label-md text-label-md text-tertiary">★ {movie.rating}</span>
              </div>
            </div>
          ))}
        </div>

        <button class="w-full mt-6 py-3 rounded bg-surface-container hover:bg-surface-container-high text-primary font-label-md text-label-md transition-colors">
          Ver Filmografía Completa
        </button>
      </section>
    </div>
  </main>
</Layout>
