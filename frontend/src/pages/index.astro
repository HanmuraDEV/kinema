const activityItems = [
  {
    name: 'Laura',
    action: 'vio',
    title: 'Cyber Dreams',
    rating: 4,
    caption: '',
  },
  {
    name: 'Miguel',
    action: 'añadió',
    title: 'El Horizonte Salado',
    meta: 'a su lista',
    listName: 'Para ver',
    time: 'Hace 2 horas',
  },
  {
    name: 'Sofía',
    action: 'vio',
    title: 'Neon Echoes',
    rating: 5,
    caption: '"Visualmente impresionante, aunque el ritmo decae en el segundo acto."',
  },
];
---

<Layout title="Kinema - Inicio">
  <main class="flex-grow w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-8 pb-32 md:pb-12 space-y-16">
    <section>
      <div class="flex items-end justify-between mb-6">
        <div>
          <h1 class="font-headline-lg-mobile md:font-headline-xl text-headline-lg-mobile md:text-headline-xl text-primary mb-2">
            Motor de Descubrimiento
          </h1>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Tendencias actuales en el cine mundial.
          </p>
        </div>
      </div>

      <div class="flex overflow-x-auto gap-6 pb-8 pt-4 no-scrollbar -mx-margin-mobile px-margin-mobile md:mx-0 md:px-0 snap-x">
        {discoveryMovies.map((movie) => (
          <article class="min-w-[280px] md:min-w-[400px] h-[400px] md:h-[500px] rounded-xl relative overflow-hidden snap-center group flex-shrink-0 cursor-pointer transition-transform duration-300 hover:-translate-y-2 border border-outline-variant/20">
            <img
              alt="Movie Poster"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              src={movie.poster}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/90 via-inverse-surface/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 w-full p-6 text-on-primary">
              <div class="flex gap-2 mb-3">
                <span class="bg-inverse-surface/70 text-on-primary text-label-sm font-label-sm px-3 py-1 rounded-md">{movie.genre}</span>
                <span class="bg-inverse-surface/70 text-on-primary text-label-sm font-label-sm px-3 py-1 rounded-md">{movie.year}</span>
              </div>
              <h2 class="font-headline-md text-headline-md font-bold mb-1">{movie.title}</h2>
              <div class={`flex items-center gap-1 ${movie.accent}`}>
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="font-label-md text-label-md">{movie.rating}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <section class="md:col-span-5 flex flex-col gap-6">
        <div class="flex items-center justify-between">
          <h3 class="font-headline-md text-headline-md text-primary">Actividad de Amigos</h3>
          <button class="text-secondary hover:text-primary transition-colors text-label-sm font-label-sm">Ver todo</button>
        </div>

        <div class="flex flex-col">
          {activityItems.map((item, index) => (
            <article class="flex gap-4 py-4 border-b border-outline-variant/30 last:border-b-0 cursor-pointer hover:bg-surface-container/50 transition-colors">
              <div class="w-12 h-12 rounded-full overflow-hidden flex-shrink-0">
                <img
                  alt="Friend Profile"
                  class="w-full h-full object-cover"
                  src={index === 0
                    ? 'https://lh3.googleusercontent.com/aida-public/AB6AXuA8SehghBuPPXsT_fsGPx4oWJhhJwuXar7VyX255Jn4zYBvUoI2pDQsXynchC5ZNpI-wUMM0zv6komj31LvpssEavbz_s_00hQX2Aml-tYVuahDo2UwlsZgYNOAH4FOTRh7lM0KAr_eAb6ESVrda2wwZhN3OTjpMEPuSLevWin4Z9mjt7G7cEHSXQdA5xt15GvTJmK_vvhO6ET2NzkCPmMZRK12vzvwVJn4G6QdDupDapRhan_J9DEeu6WcF8n79eLJ4hKFBKEcvBA'
                    : index === 1
                      ? 'https://lh3.googleusercontent.com/aida-public/AB6AXuC5Ts0yvN8GwBFbjUGJ3HFt_MN3cS57wVpqndYRTc7UqoYNSVc-alhN9zwFzC4Diy4qpB4G7CNlksTOdId0sz9ItqsD6TJz8mx7_nRGHUncify3Yp9_54ToR7ByEduaEhPvjUN5Q5u_PfVFeY_KH3_pgNFmWiI09GsvGLObeZbFj8zMEQLL9a45OfbayXMGzHeqhf7bKzO1XnxgohMuScXVfllUjF2Ui0nubHR3x2QP9e6etilm10VElhgA4s__ijR8wopkeM2_NL0'
                      : 'https://lh3.googleusercontent.com/aida-public/AB6AXuC6YrSFn55U7vNYClDkD9Esg-sMiHQb4a9f0rnUSCZHrfYC55PGjZYC7EuF8RFbMbi2baUuRPQOvds6TBz0oRB-DF_8HmCgMeucXg93TqRY0AlCkP_UfHc54U2_kiqjajbJ2fULgRpJ2gYu07WPnDxv2v4Bzyu0dRhRhq02cH2ocHWP-8l14OH4x074UGhX2nXK_0C6qdq5WY0SyZ9J-TDocbXVVE1nyzIMXsN-bEkXmYVYg6lfsjXLMdgH04OCuSSe3-WMpuPiiLk'}
                />
              </div>
              <div class="flex-grow">
                <p class="font-body-sm text-body-md">
                  <span class="font-bold text-on-surface">{item.name}</span>
                  {' '}{item.action}{' '}
                  <span class="font-semibold text-secondary">{item.title}</span>
                  {item.meta ? ` ${item.meta} ` : ''}
                  {item.listName ? <span class="italic text-on-surface-variant">{item.listName}</span> : ''}
                </p>

                {item.rating ? (
                  <div class="flex text-tertiary mt-1">
                    {Array.from({ length: 4 }).map(() => (
                      <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                    ))}
                    <span class="material-symbols-outlined text-[16px]">star</span>
                  </div>
                ) : null}

                {item.time ? <p class="text-label-sm font-label-sm text-on-surface-variant/70 mt-1">{item.time}</p> : null}

                {item.caption ? (
                  <p class="text-body-md mt-2 text-on-surface-variant italic border-l-2 border-outline-variant/50 pl-3 py-1">
                    {item.caption}
                  </p>
                ) : null}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="md:col-span-7 flex flex-col gap-6 mt-12 md:mt-0">
        <div class="flex items-center justify-between">
          <h3 class="font-headline-md text-headline-md text-primary">Personalizado para ti</h3>
          <span class="text-secondary text-label-sm font-label-sm px-3 py-1 rounded-md border border-secondary/30">Basado en tu perfil</span>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <Card
            imageAlt="Movie Scene"
            imageSrc="https://lh3.googleusercontent.com/aida-public/AB6AXuD3_SovpNkMdZiuprCHISlBAcmYZZFRBk6J_9CUJnvujNMkuuMqvkFTtq8QDsSaf23olTxjoovnIsqecczJ9QjeGlsc_h_ZNh8wH-MNZkNSa19dMvcV0XQgFXIXihj-62zj9DE7dUwmkyLQ2Z5q2oqgUNWiUDxTso_B93FaeyhslgMvNCDU25xEycR--3X23A1GjzZCU_NNCjm-q7opQSPGGPZfG_8fhiv2UDtCLwJU28HC02blryXS0q3xEhWew8voRmp0_gWDQG8"
            variant="default"
          >
            <h4 class="font-label-md text-label-md font-bold text-on-surface mb-1">Tardes de Domingo</h4>
            <p class="font-label-sm text-label-sm text-outline mb-2">Comedia Indie • 2022</p>
            <div class="flex items-center justify-between">
              <span class="text-primary font-bold text-label-md">98% Match</span>
              <button class="w-8 h-8 rounded-md bg-secondary-container text-on-secondary-container flex items-center justify-center hover:bg-secondary-container/80 transition-colors">
                <span class="material-symbols-outlined text-[18px]">add</span>
              </button>
            </div>
          </Card>

          <Card
            imageAlt="Movie Scene"
            imageSrc="https://lh3.googleusercontent.com/aida-public/AB6AXuAmd5iSZBuZd9-4AkZEIRh9aKmCAEjWfkcl4wyqc-UgplGtZ1bCFhwYX0MMtwjzb7YoBjmQuSpZk0-08EW0UlsTRstuSQLpr5qP1T4ljpWTtJE9_5xIAyCb42uWB5ksbSb0yjWOymo3c3zNSIJhnEIT0sb1TJC6JRpBbD-V19uXTxu3x1c_rgHLMluVMNQPTgSWO104adAWw0nei_GWp3aqmrvS0CKM-5MFgcqS4hPUjfXgjl6BysRMpAQNfnqiduS6YawVYOrXp9M"
            variant="default"
          >
            <h4 class="font-label-md text-label-md font-bold text-on-surface mb-1">Ondas Sintéticas</h4>
            <p class="font-label-sm text-label-sm text-outline mb-2">Documental Musical • 2021</p>
            <div class="flex items-center justify-between">
              <span class="text-primary font-bold text-label-md">95% Match</span>
              <button class="w-8 h-8 rounded-md bg-secondary-container text-on-secondary-container flex items-center justify-center hover:bg-secondary-container/80 transition-colors">
                <span class="material-symbols-outlined text-[18px]">add</span>
              </button>
            </div>
          </Card>

          <Card class="col-span-2" mediaClass="h-auto" variant="feature">
            <div slot="media" class="w-12 h-12 flex items-center justify-center text-primary mr-4 flex-shrink-0">
              <span class="material-symbols-outlined text-[32px]">auto_awesome</span>
            </div>
            <div class="flex flex-row items-center py-4">
              <div class="flex-grow">
                <h4 class="font-label-md text-label-md font-bold text-on-surface">Explorar Colección: Neo-Tokyo</h4>
                <p class="font-body-sm text-body-md text-on-surface-variant/80 mt-1">Porque te gustó "Akira" y "Ghost in the Shell".</p>
              </div>
              <span class="material-symbols-outlined text-primary">chevron_right</span>
            </div>
          </Card>
        </div>
      </section>
    </div>
  </main>
</Layout>
