---
import Layout from '../layouts/Layout.vue';
import Card from '../components/Card.vue';
import Button from '../components/Button.vue';
import FeedActivity from '../components/FeedActivity.vue';

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

let discoveryMovies = [];
try {
  const res = await fetch(`${API_URL}/api/movies`);
  if (res.ok) {
    const json = await res.json();
    const list = json.data ?? json;
    discoveryMovies = (Array.isArray(list) ? list : []).slice(0, 3).map((m) => ({
      id: m.id,
      title: m.title,
      genre: m.vibe?.name ?? 'Cine',
      year: (m.release_date || '').toString().slice(0, 4),
      rating: '—',
      poster: m.poster_path || '',
    }));
  }
} catch (e) {
  console.error('No se pudo cargar el catálogo:', e);
}

if (discoveryMovies.length === 0) {
  discoveryMovies = [
    { id: null, title: 'Neon Echoes', genre: 'Sci-Fi', year: '2024', rating: '4.8', poster: '' },
    { id: null, title: 'El Horizonte Salado', genre: 'Drama', year: '2023', rating: '4.2', poster: '' },
    { id: null, title: 'Digital Nostalgia', genre: 'Documental', year: '2024', rating: '4.9', poster: '' },
  ];
}
---

<Layout title="Kinema - Inicio">
  <main class="flex-grow w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-8 pb-32 md:pb-12 space-y-16">
    <section>
      <div class="flex items-end justify-between mb-6">
        <div>
          <h1 class="font-headline-lg-mobile md:font-headline-xl text-headline-lg-mobile md:text-headline-xl text-primary mb-2">
            Motor de Descubrimiento
          </h1>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Tendencias actuales en el cine mundial.
          </p>
        </div>
        <a href="/search" class="font-label-md text-label-md text-secondary hover:underline">Ver catálogo</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pb-8 pt-4">
        {discoveryMovies.map((movie) => (
          <a href={movie.id ? `/movie?id=${movie.id}` : '/search'} class="min-w-0 h-[400px] md:h-[500px] rounded-xl relative overflow-hidden group cursor-pointer transition-transform duration-300 hover:-translate-y-2 border border-outline-variant/20 ambient-shadow-secondary block">
            {movie.poster ? (
              <img
                alt={movie.title}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                src={movie.poster}
              />
            ) : (
              <div class="absolute inset-0 w-full h-full bg-gradient-to-br from-secondary-container/40 to-primary-container/40 flex items-center justify-center p-8 text-center font-headline-md text-headline-md text-on-surface-variant">{movie.title}</div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/90 via-inverse-surface/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 w-full p-6 text-on-primary">
              <div class="flex gap-2 mb-3">
                <span class="bg-inverse-surface/70 text-on-primary text-label-sm font-label-sm px-3 py-1 rounded-full">{movie.genre}</span>
                <span class="bg-inverse-surface/70 text-on-primary text-label-sm font-label-sm px-3 py-1 rounded-full">{movie.year}</span>
              </div>
              <h2 class="font-headline-md text-headline-md font-bold mb-1">{movie.title}</h2>
            </div>
          </a>
        ))}
      </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <section class="md:col-span-5 flex flex-col gap-6">
        <div class="flex items-center justify-between">
          <h3 class="font-headline-md text-headline-md text-primary">Actividad de Amigos</h3>
        </div>
        <FeedActivity client:load />
      </section>

      <section class="md:col-span-7 flex flex-col gap-6 mt-12 md:mt-0">
        <div class="flex items-center justify-between">
          <h3 class="font-headline-md text-headline-md text-primary">Personalizado para ti</h3>
          <span class="text-secondary text-label-sm font-label-sm px-3 py-1 rounded-full border border-secondary/30">Basado en tu perfil</span>
        </div>

        <div class="glass-panel rounded-xl p-6">
          <p class="font-body-md text-body-md text-on-surface-variant">
            Tus recomendaciones aparecen cuando calificas películas y sigues a otros cinéfilos.
          </p>
          <div class="mt-4 flex gap-3">
            <a href="/search"><Button label="Descubrir" variant="primary" /></a>
            <a href="/register"><Button label="Crear cuenta" variant="secondary" /></a>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>
