    genre: 'Sci-Fi',
    year: '2024',
    rating: '4.8',
    poster:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuDWHQAA2XSTsEp4-ADXL2OrOeUC9yyZQmfG6ZcaI0_3CsPUa5DTUeu-rDtaKWqP56HN3sGbja_THXb8QZFFgIgCrdCGoUc_wDSCFG8FqQD4JjgzSSevhCZ7sN63mVML3o4gI9UCu5mCCV0Td73CGXBMESR3CuZleb2c3llTzJnZ6sjqez0mioGp0iDv-5_u16yzyTYrtu4g2PlYd7mgWjyG2iLS1iBzWFOtd1FMIjVzqez93Kx2HnWwoCk8NXEqpHbsUnWbg4CK2Es',
    accent: 'text-secondary-fixed',
  },
  {
    title: 'El Horizonte Salado',
    genre: 'Drama',
    year: '2023',
    rating: '4.2',
    poster:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuAz65Pv1l_NsP2WozhEPHA-V2SRANPbD1eKb05AX9m-533aUXW-0ioIzq2Tqs7CnDJbkNg02gty13NF1hydU0IOcmzRDYrB6lqMmCLdBup5ypN8Ge8SixRcJ8rAyU2eookxzNr_O8QX48rQDc31vH-FzQCFRcjvWpPvaSVGV58HJc6WGOJy-cHHBfO2ApvGZBoW6oV2oriSzvIp-Vs_JvE2KnzqOjakYvW1M8iOPJG_SYl-OJkzZJ2H5rktHSyjSS-j0l54AzYLzsY',
    accent: 'text-primary-fixed',
  },
  {
    title: 'Digital Nostalgia',
    genre: 'Documental',
    year: '2024',
    rating: '4.9',
    poster:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuBjNb_yCtU8WPQmgpd6uwv32eE3ATVLA3E-pmA4iBqEigJDQCell3-l28K8ntTN17AnuobG4zIEoD6o9WbvoDdcIS7zHDtqJuB3EEWI2pZbIhw5UgziSR5fBRGKM1IEwn3mFRXSmEwenvnVdLwRrhG3g0tGBHl_P4onMFB2EPL-vEsQJCqbEyLO_vDc4gZ4N4-Dqro_XExtMlA7MNlP-G3jsa6dwc7JFMJaRr4aBZz_fO5JMnUcZxahLRyq5AdlSgWqtaqxhU1aHQE',
    accent: 'text-secondary-fixed',
  },
