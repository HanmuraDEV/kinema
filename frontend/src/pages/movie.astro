---
import Layout from '../layouts/Layout.astro';
import MoviePosterPanel from '../components/MoviePosterPanel.astro';
import MovieCastList from '../components/MovieCastList.astro';
import MovieRatingStats from '../components/MovieRatingStats.astro';
import MovieTonePanel from '../components/MovieTonePanel.astro';

