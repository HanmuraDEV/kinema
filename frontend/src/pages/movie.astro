---
import Layout from '../layouts/Layout.astro';
import MoviePosterPanel from '../components/MoviePosterPanel.vue';
import MovieCastList from '../components/MovieCastList.vue';
import MovieRatingStats from '../components/MovieRatingStats.vue';
import Card from '../components/Card.vue';
import ReviewForm from '../components/ReviewForm.vue';
import MovieActions from '../components/MovieActions.vue';
import MovieRating from '../components/MovieRating.vue';
import GenreRadar from '../components/GenreRadar.vue';

const money = (v) => {
  if (v === null || v === undefined || v === 0) return null;
  if (v >= 1_000_000_000) return `$${(v / 1_000_000_000).toFixed(1)}B`;
  if (v >= 1_000_000) return `$${(v / 1_000_000).toFixed(0)}M`;
  return `$${Number(v).toLocaleString('en-US')}`;
};

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
const movieId = Astro.url.searchParams.get('id');

// Sin id no hay película que mostrar: al catálogo
if (!movieId) {
  return Astro.redirect('/search');
}

let movie = null;
let similar = [];
let reviews = [];
let sentiment = null;
let cast = [];
let directors = [];

if (movieId) {
  try {
    const res = await fetch(`${API_URL}/api/movies/${movieId}`);
    if (res.ok) movie = await res.json();
  } catch (e) { console.error('movie show falló:', e); }
  try {
    const res = await fetch(`${API_URL}/api/movies/${movieId}/similar`);
    if (res.ok) similar = await res.json();
  } catch (e) { console.error('similar falló:', e); }
  try {
    const res = await fetch(`${API_URL}/api/movies/${movieId}/reviews`);
    if (res.ok) {
      const json = await res.json();
      reviews = json.data ?? json ?? [];
    }
  } catch (e) { console.error('reviews falló:', e); }
  try {
    const res = await fetch(`${API_URL}/api/movies/${movieId}/sentiment`);
    if (res.ok) sentiment = await res.json();
  } catch (e) { console.error('sentiment falló:', e); }
  try {
    const res = await fetch(`${API_URL}/api/movies/${movieId}/credits`);
    if (res.ok) {
      const json = await res.json();
      cast = (json.cast ?? []).map((c) => ({
        id: c.person?.id,
        name: c.person?.name ?? '?',
        role: c.character || c.job,
        image: c.person?.profile_path || '',
      }));
      directors = (json.directors ?? []).map((d) => ({
        id: d.person?.id,
        name: d.person?.name ?? '?',
      }));
    }
  } catch (e) { console.error('credits falló:', e); }
}

const fallback = {
  title: 'El Resplandor del Mañana',
  year: '2024',
  director: '—',
  runtime: '—',
  genres: ['Ciencia Ficción', 'Drama'],
  synopsis: 'Abre una película con ?id= para ver sus datos reales desde la API.',
  poster: '',
  cast: [],
  ratingBars: [],
};
const m = movie ?? fallback;
const year = m.release_date ? String(m.release_date).slice(0, 4) : (m.year ?? '');
---

<Layout title={`Kinema - ${m.title ?? 'Película'}`}>
  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 pb-32">
    {!movie && (
      <div class="glass-panel rounded-xl p-6 mb-8">
        <p class="font-body-md text-body-md text-on-surface-variant">
          No encontramos esa película. <a href="/search" class="text-secondary hover:underline">Volver al catálogo</a>.
        </p>
      </div>
    )}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <div class="md:col-span-4 flex flex-col gap-6">
        <MoviePosterPanel poster={m.poster_path || m.poster} title={m.title} />
        {movieId && <MovieActions client:load movieId={movieId} movieTitle={m.title} />}
      </div>

      <div class="md:col-span-8 flex flex-col gap-8">
        <div class="flex flex-col gap-2">
          <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-background">
            {m.title}
          </h1>

          <div class="flex items-center gap-4 text-on-surface-variant font-label-sm text-label-sm">
            <span>{year}</span>
            {directors.length > 0 && (
              <>
                <span>•</span>
                <span>Dir. {directors.map((d, i) => (
                  <span>{i > 0 && ', '}<a href={`/artists/${d.id}/profile`} class="hover:text-secondary hover:underline">{d.name}</a></span>
                ))}</span>
              </>
            )}
            {m.vibe && (<><span>•</span><span class="rounded-full border border-secondary/30 px-3 py-1 text-secondary">{m.vibe.name}</span></>)}
          </div>
        </div>

        <div class="pt-6 border-t border-outline-variant/30">
          <h3 class="font-headline-md text-headline-md mb-4 text-secondary">Sinopsis</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">{m.overview || m.synopsis || 'Sin sinopsis todavía.'}</p>
        </div>

        {movieId && <MovieRating client:load movieId={movieId} />}

        {movie?.rating_stats && movie.rating_stats.count > 0 && (
          <div class="pt-6 border-t border-outline-variant/30">
            <MovieRatingStats
              ratingBars={movie.rating_stats.bars}
              average={movie.rating_stats.average}
              count={movie.rating_stats.count}
            />
          </div>
        )}

        {cast.length > 0 && (
          <MovieCastList cast={cast} />
        )}

      </div>
    </div>

    {(m.vibe_neighborhood?.length > 0 || (m.budget > 0 && m.revenue > 0)) && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
            {m.vibe_neighborhood?.length > 0 && (
          <div class="rounded-[24px] border border-outline-variant/20 bg-surface/60 p-6">
            <GenreRadar title="Vibras cercanas" items={m.vibe_neighborhood} showTitle={false} showLegend={false} />
          </div>
            )}
            {(m.budget > 0 && m.revenue > 0) && (
              <div class="rounded-[24px] border border-outline-variant/20 bg-surface/60 p-6 flex flex-col justify-center">
                <h3 class="font-headline-md text-headline-md mb-2 text-secondary text-center">Taquilla mundial</h3>
                {(() => {
                  const max = Math.max(m.budget, m.revenue);
                  const W = 300, H = 170, PADL = 52, PADB = 26, PADT = 30;
                  const x0 = PADL + 40, x1 = W - 40;
                  const yOf = (v) => PADT + (1 - v / max) * (H - PADT - PADB);
                  const yB = yOf(m.budget), yR = yOf(m.revenue);
                  const roi = m.budget > 0 ? (m.revenue / m.budget).toFixed(1) : null;
                  const gridVals = [0, 0.25, 0.5, 0.75, 1].map((t) => max * t);
                  return (
                    <>
                      <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto" role="img" aria-label="Evolución presupuesto a recaudación">
                        {gridVals.map((g) => (
                          <>
                            <line x1={PADL} x2={W - 10} y1={yOf(g)} y2={yOf(g)} stroke="#c1c9be" stroke-opacity="0.4" stroke-width="1" />
                            <text x={PADL - 6} y={yOf(g) + 3} text-anchor="end" font-size="9" fill="#717970">{money(g)}</text>
                          </>
                        ))}
                        <line x1={x0} y1={yB} x2={x1} y2={yR} stroke="#006a68" stroke-width="2.5" stroke-linecap="round" />
                        <circle cx={x0} cy={yB} r="5" fill="#ffffff" stroke="#006a68" stroke-width="2.5">
                          <title>Presupuesto: {money(m.budget)}</title>
                        </circle>
                        <circle cx={x1} cy={yR} r="5" fill="#006a68">
                          <title>Recaudación: {money(m.revenue)}</title>
                        </circle>
                        <text x={x0} y={H - 8} text-anchor="middle" font-size="9" fill="#717970">Presupuesto</text>
                        <text x={x1} y={H - 8} text-anchor="middle" font-size="9" fill="#717970">Recaudación</text>
                        <text x={x0} y={yB - 10} text-anchor="middle" font-size="10" font-weight="bold" fill="#191c1d">{money(m.budget)}</text>
                        <text x={x1} y={yR - 10} text-anchor="middle" font-size="10" font-weight="bold" fill="#191c1d">{money(m.revenue)}</text>
                      </svg>
                      <div class="flex justify-between items-center pt-1">
                        {roi && <span class="font-label-md text-label-md text-primary">×{roi} retorno</span>}
                        {m.runtime > 0 && <span class="font-label-sm text-label-sm text-on-surface-variant">{m.runtime} min</span>}
                        <span class="font-label-sm text-label-sm text-on-surface-variant/70">Fuente: TMDB</span>
                      </div>
                    </>
                  );
                })()}
              </div>
            )}
          </div>
        )}

        {(sentiment && ((sentiment.POSITIVE ?? 0) + (sentiment.NEGATIVE ?? 0) > 0)) && (
          <div class="grid grid-cols-1 gap-gutter pt-6 border-t border-outline-variant/30">
            {sentiment && ((sentiment.POSITIVE ?? 0) + (sentiment.NEGATIVE ?? 0) > 0) && (
              <div class="glass-panel rounded-xl p-6">
                <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Pulso de la comunidad</h3>
                {(() => {
                  const pos = sentiment.POSITIVE ?? 0;
                  const neg = sentiment.NEGATIVE ?? 0;
                  const total = pos + neg;
                  const posPct = Math.round((pos / total) * 100);
                  return (
                    <>
                      <div class="flex h-4 w-full overflow-hidden rounded-full bg-surface-container-highest">
                        <div class="h-full bg-primary" style={`width: ${posPct}%`} />
                        <div class="h-full bg-tertiary" style={`width: ${100 - posPct}%`} />
                      </div>
                      <div class="mt-3 flex justify-between font-label-md text-label-md">
                        <span class="text-primary">▲ {pos} positivas ({posPct}%)</span>
                        <span class="text-tertiary">▼ {neg} negativas ({100 - posPct}%)</span>
                      </div>
                      <p class="mt-2 font-label-sm text-label-sm text-on-surface-variant">Análisis de sentimiento de las reseñas con NLP.</p>
                    </>
                  );
                })()}
              </div>
            )}
          </div>
        )}

    <section class="mt-12 border-t border-outline-variant/30 pt-8">
      <div class="mb-6">
        <h2 class="font-headline-md text-headline-md text-secondary">Reseñas de usuarios</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">Lo que la comunidad piensa de esta película.</p>
      </div>

      {movieId && <ReviewForm client:load movieId={movieId} />}

      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 mt-6">
        {reviews.map((review) => (
          <Card class="border border-outline-variant/20" variant="feature" bodyClass="p-5">
            <div class="flex items-start gap-4">
              <div class="h-10 w-10 shrink-0 rounded-full bg-primary-container flex items-center justify-center font-bold text-on-primary-container">
                {(review.user?.name || '?').charAt(0).toUpperCase()}
              </div>
              <div class="min-w-0 flex-1">
                <div class="mb-2 flex items-center justify-between gap-3">
                  <h3 class="font-label-md text-label-md font-bold text-on-surface">{review.user?.name}</h3>
                  {review.rating && (
                    <span class="flex shrink-0 items-center gap-1 font-label-md text-label-md text-tertiary">
                      <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                      {review.rating}
                    </span>
                  )}
                </div>
                <p class="font-body-md text-body-md text-on-surface-variant">{review.content}</p>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </section>

    {similar.length > 0 && (
      <section class="mt-12 border-t border-outline-variant/30 pt-8">
        <h2 class="font-headline-md text-headline-md mb-6 text-secondary">Similares</h2>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
          {similar.map((s) => (
            <a href={`/movie?id=${s.id}`} class="group rounded-xl overflow-hidden ambient-shadow-secondary bg-white">
              {s.poster_path && <img alt={s.title} class="w-full aspect-[2/3] object-cover group-hover:scale-105 transition-transform" src={s.poster_path} />}
              <div class="p-3 font-label-md text-label-md text-on-surface">{s.title}</div>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
